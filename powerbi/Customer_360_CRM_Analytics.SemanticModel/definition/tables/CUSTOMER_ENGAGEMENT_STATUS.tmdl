table CUSTOMER_ENGAGEMENT_STATUS
	lineageTag: b07b746a-a96d-4e21-b5eb-1a3c34847ef7

	measure 'Total Households' =
			
			DISTINCTCOUNT(
			    CUSTOMER_ENGAGEMENT_STATUS[HOUSEHOLD_KEY]
			)
		formatString: 0
		lineageTag: 473600d8-e3ed-4caf-ad8d-3392fde3272c

	measure 'Total Sales Value' =
			
			SUM(
			    CUSTOMER_ENGAGEMENT_STATUS[TOTAL_SALES_VALUE]
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 12192360-40ca-43b3-81ea-ab5915bb4f94

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Overall Basket Value' =
			
			DIVIDE(
			    SUM(CUSTOMER_ENGAGEMENT_STATUS[TOTAL_SALES_VALUE]),
			    SUM(CUSTOMER_ENGAGEMENT_STATUS[TOTAL_BASKETS])
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 4415f161-2c9c-43a7-850e-378d668f1cba

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Potential Lapse Households' =
			
			CALCULATE(
			    DISTINCTCOUNT(CUSTOMER_ENGAGEMENT_STATUS[HOUSEHOLD_KEY]),
			    CUSTOMER_ENGAGEMENT_STATUS[ENGAGEMENT_STATUS] = "Potential Lapse"
			)
		formatString: 0
		lineageTag: 38e7133c-2669-4a2a-8a4b-544a6bab4e1f

	measure 'Potential Lapse %' =
			
			DIVIDE(
			    [Potential Lapse Households],
			    [Total Households]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 36a3f763-7878-4802-8128-f40f3d75b2c8

	measure 'Campaign Assigned Households' =
			
			CALCULATE(
			    DISTINCTCOUNT(CUSTOMER_ENGAGEMENT_STATUS[HOUSEHOLD_KEY]),
			    CUSTOMER_ENGAGEMENT_STATUS[HAS_CAMPAIGN_ASSIGNMENT] = TRUE()
			)
		formatString: 0
		lineageTag: 52084583-7041-4107-9fb5-5ed31e248b2e

	measure 'Coupon Redeeming Households' =
			
			CALCULATE(
			    DISTINCTCOUNT(CUSTOMER_ENGAGEMENT_STATUS[HOUSEHOLD_KEY]),
			    CUSTOMER_ENGAGEMENT_STATUS[HAS_COUPON_REDEMPTION] = TRUE()
			)
		formatString: 0
		lineageTag: 74285ceb-d930-4f2a-ba0e-296fd2c058cb

	measure 'HVI Households' =
			
			CALCULATE(
			    DISTINCTCOUNT(CUSTOMER_ENGAGEMENT_STATUS[HOUSEHOLD_KEY]),
			    CUSTOMER_ENGAGEMENT_STATUS[CUSTOMER_SEGMENT] = "High-Value Inactive"
			)
		formatString: 0
		lineageTag: 78a8e88c-f910-40f2-851e-9e5c9e6db628

	measure 'HVI Potential Lapse' =
			
			CALCULATE(
			    DISTINCTCOUNT(CUSTOMER_ENGAGEMENT_STATUS[HOUSEHOLD_KEY]),
			    CUSTOMER_ENGAGEMENT_STATUS[CUSTOMER_SEGMENT] = "High-Value Inactive",
			    CUSTOMER_ENGAGEMENT_STATUS[ENGAGEMENT_STATUS] = "Potential Lapse"
			)
		formatString: 0
		lineageTag: 2b195a31-d2b5-4965-a9b3-e3622ae039a3

	measure 'HVI Potential Lapse Rate' =
			
			DIVIDE(
			    [HVI Potential Lapse],
			    [HVI Households]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b2c7cf76-ed30-43fc-b75b-efc2023e39d1

	measure 'HVI Lapse Historical Sales' =
			
			CALCULATE(
			    SUM(CUSTOMER_ENGAGEMENT_STATUS[TOTAL_SALES_VALUE]),
			    CUSTOMER_ENGAGEMENT_STATUS[CUSTOMER_SEGMENT] = "High-Value Inactive",
			    CUSTOMER_ENGAGEMENT_STATUS[ENGAGEMENT_STATUS] = "Potential Lapse"
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 34a87263-7c8b-4c7a-a150-0d22586a976f

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Demographic Households' =
			
			CALCULATE(
			    DISTINCTCOUNT(CUSTOMER_ENGAGEMENT_STATUS[HOUSEHOLD_KEY]),
			    CUSTOMER_ENGAGEMENT_STATUS[HAS_DEMOGRAPHICS] = TRUE()
			)
		formatString: 0
		lineageTag: b92cb516-2d27-4a27-bd0c-17a2c4b406e4

	measure 'Age Group %' =
			
			DIVIDE(
			    [Demographic Households],
			    CALCULATE(
			        [Demographic Households],
			        REMOVEFILTERS(CUSTOMER_ENGAGEMENT_STATUS[AGE_DESC])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 66afd94e-1ce9-4b7f-b957-5bd7e4db7483

	measure 'Household Composition %' =
			
			DIVIDE(
			    [Demographic Households],
			    CALCULATE(
			        [Demographic Households],
			        REMOVEFILTERS(CUSTOMER_ENGAGEMENT_STATUS[HH_COMP_DESC])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9a2e139f-cb66-4407-919b-f030892560fe

	measure 'Income Group %' =
			
			DIVIDE(
			    [Demographic Households],
			    CALCULATE(
			        [Demographic Households],
			        REMOVEFILTERS(CUSTOMER_ENGAGEMENT_STATUS[INCOME_DESC])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 58b15a8a-f693-409b-ac77-d652ecf5c5dd

	measure 'Selected Segment Name' =
			
			SELECTEDVALUE(
			    SEGMENT_PROFILE[CUSTOMER_SEGMENT],
			    "All Segments"
			)
		lineageTag: 670ba31b-4dad-4549-94db-a97a601f3a86

	measure 'Demographic Coverage Text' =
			
			"Coverage: "
			    & FORMAT([Selected Demographic Coverage %], "0.0%")
			    & " ("
			    & FORMAT([Demographic Households], "#,0")
			    & " of "
			    & FORMAT([Selected Segment Households], "#,0")
			    & " households)"
		lineageTag: 396d344d-651f-4d7b-ba98-e2623c3494a5

	measure 'Strong Decline Households' =
			
			CALCULATE(
			    DISTINCTCOUNT(CUSTOMER_ENGAGEMENT_STATUS[HOUSEHOLD_KEY]),
			    CUSTOMER_ENGAGEMENT_STATUS[ENGAGEMENT_STATUS] = "Strong Decline"
			)
		formatString: 0
		lineageTag: f1744b0d-e5a4-4155-844c-32e363b1e5f2

	measure 'Strong Decline %' =
			
			DIVIDE(
			    [Strong Decline Households],
			    [Total Households]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ab3b8479-e6e5-4b1d-a5e6-06862416679e

	measure 'Potential Lapse Share %' =
			
			DIVIDE(
			    [Potential Lapse Households],
			    [Total Households]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ee9d0f85-31f0-46ce-b4f3-c91bee0947a3

	measure 'HVI Total Households' =
			
			CALCULATE(
			    DISTINCTCOUNT(CUSTOMER_ENGAGEMENT_STATUS[HOUSEHOLD_KEY]),
			    CUSTOMER_ENGAGEMENT_STATUS[CUSTOMER_SEGMENT] = "High-Value Inactive"
			)
		formatString: 0
		lineageTag: c9c5cec5-fc46-4f47-839c-4863b28ed2d6

	measure 'HVI Lapse Households' =
			
			CALCULATE(
			    DISTINCTCOUNT(CUSTOMER_ENGAGEMENT_STATUS[HOUSEHOLD_KEY]),
			    CUSTOMER_ENGAGEMENT_STATUS[CUSTOMER_SEGMENT] = "High-Value Inactive",
			    CUSTOMER_ENGAGEMENT_STATUS[ENGAGEMENT_STATUS] = "Potential Lapse"
			)
		formatString: 0
		lineageTag: aac10074-9687-4945-8614-57aa240db186

	measure 'HVI Lapse Rate' =
			
			DIVIDE(
			    [HVI Lapse Households],
			    [HVI Total Households]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2413fe19-e95c-4777-9b40-3484ddc79c05

	measure Measure
